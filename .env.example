# Copy to .env if you want to override anything. docker compose reads it automatically.

# stub | real   -- "stub" boots instantly with fake matches, useful for frontend work
MATCHER_IMPL=real

# bge-small | minilm          (see docs/02-models.md)
BI_ENCODER=bge-small
CROSS_ENCODER=ms-marco-l6

CANDIDATE_TOP_N=25
DEFAULT_TOP_K=5
