# Copy this file to .env. docker compose reads .env automatically, so you never need to
# put variables in front of the command (which does not work in PowerShell anyway).
#
#   cp .env.example .env
#   docker compose up --build

# stub | real
#   stub = instant boot, fake but plausible matches. Use it for front-end and API work.
#   real = the actual pipeline. Needs the models in the image, so BAKE_MODELS=1.
MATCHER_IMPL=stub

# 1 | 0
#   1 = download the models during the build and bake them into the image (5-10 min the
#       first time, cached afterwards). Required for MATCHER_IMPL=real.
#   0 = skip the download entirely. Builds in about a minute. Only valid with the stub.
BAKE_MODELS=0

# bge-small | minilm          (see docs/02-models.md)
BI_ENCODER=bge-small
CROSS_ENCODER=ms-marco-l6

CANDIDATE_TOP_N=25
DEFAULT_TOP_K=5
